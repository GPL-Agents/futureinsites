{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/deepseek-cheap-again",
      "destination": "/blog/deepseek-cheap-again.html"
    },
    {
      "source": "/client-login",
      "destination": "/client-login.html"
    }
  ],
  "headers": [
    {
      "source": "/client-login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/client-login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/head-of-ai",
      "destination": "/greg-loeffelholz",
      "permanent": true
    },
    {
      "source": "/head-of-ai.html",
      "destination": "/greg-loeffelholz",
      "permanent": true
    },
    {
      "source": "/hire-greg",
      "destination": "/greg-loeffelholz",
      "permanent": true
    },
    {
      "source": "/hire-greg.html",
      "destination": "/greg-loeffelholz",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/our-story",
      "permanent": false
    },
    {
      "source": "/team.html",
      "destination": "/our-story",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "futureinsites.com"
        }
      ],
      "destination": "https://www.futureinsites.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "free-ai-assessment.com"
        }
      ],
      "destination": "https://www.futureinsites.com/ai-readiness.html?utm_source=free-ai-assessment&utm_medium=domain-redirect",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.free-ai-assessment.com"
        }
      ],
      "destination": "https://www.futureinsites.com/ai-readiness.html?utm_source=free-ai-assessment&utm_medium=domain-redirect",
      "permanent": false
    }
  ]
}
