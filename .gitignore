# FUSE filesystem artifacts (created by the Cowork mount when a file is
# deleted while still held open by a Windows process; safe to ignore)
.fuse_hidden*

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor temp/swap files
*.swp
*~
*.bak
.vscode/
.idea/

# Logs
*.log

# Secrets / API keys (never commit these)
keys.txt
api/keys.txt
*.key
.env
.env.*
