# Preferred: one independent credential variable per client workspace.
# Hyphens in a workspace slug become underscores in the environment name.
# Generate values with: pnpm client:credential <workspace>
CLIENT_WORKSPACE_TRACE={"salt":"REPLACE_WITH_BASE64URL_SALT","hash":"REPLACE_WITH_BASE64URL_SCRYPT_HASH"}
CLIENT_WORKSPACE_COMBUILDERS={"salt":"REPLACE_WITH_BASE64URL_SALT","hash":"REPLACE_WITH_BASE64URL_SCRYPT_HASH"}

# Compatibility fallback for deployments that still use one aggregate map.
# CLIENT_AUTH_CONFIG={"trace":{"salt":"REPLACE_WITH_BASE64URL_SALT","hash":"REPLACE_WITH_BASE64URL_SCRYPT_HASH"}}

# At least 32 cryptographically random bytes encoded as base64url.
CLIENT_SESSION_SECRET=REPLACE_WITH_BASE64URL_SECRET

# Optional. Sessions default to eight hours and are capped at 24 hours.
CLIENT_SESSION_TTL_SECONDS=28800
