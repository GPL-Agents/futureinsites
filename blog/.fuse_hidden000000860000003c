  <!-- LIGHTBOX SCRIPT -->
  <script>
    (function () {
      var figs = document.querySelectorAll('.article-figure img');
      if (!figs.length) return;

      function openLightbox(src, alt) {
        var overlay = document.createElement('div');
        overlay.className = 'lightbox-overlay';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-label', 'Image viewer');

        var closeBtn = document.createElement('button');
        closeBtn.className = 'lightbox-close';
        closeBtn.setAttribute('aria-label', 'Close image viewer');
        closeBtn.innerHTML = '&times;';

        var img = document.createElement('img');
        img.src = src;
        img.alt = alt || '';

        overlay.appendChild(closeBtn);
        overlay.appendChild(img);

        function close() {
          overlay.remove();
          document.body.classList.remove('lb-open');
          document.removeEventListener('keydown', onKey);
        }

        function onKey(e) { if (e.key === 'Escape') close(); }

        overlay.addEventListener('click', function (e) {
          if (e.target === overlay || e.target === closeBtn) close();
        });
        img.addEventListener('click', function (e) { e.stopPropagation(); });

        document.body.appendChild(overlay);
        document.body.classList.add('lb-open');
        document.addEventListener('keydown', onKey);
      }

      figs.forEach(function (img) {
        img.addEventListener('click', function () {
          openLightbox(img.src, img.alt);
        });
      });
    })();
  </script>

  <script>
  /* Hamburger toggle */
  (function () {
    var btn  = document.getElementById('nav-hamburger');
    var menu = document.getElementById('nav-links-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      menu.classList.toggle('open');
    });
    document.addEventListener('click', function (e) {
      if (!btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.remove('open');
      }
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.remove('open');
      });
    });
  })();
  /* Dropdown toggles */
  (function () {
    var allMore = document.querySelectorAll('.nav-more');
    if (!allMore.length) return;
    allMore.forEach(function (more) {
      var btn = more.querySelector('.nav-more-btn');
      if (!btn) return;
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var isOpen = more.classList.contains('open');
        allMore.forEach(function (m) { m.classList.remove('open'); });
        if (!isOpen) { more.classList.add('open'); }
      });
      more.querySelectorAll('.nav-more-dropdown a').forEach(function (a) {
        a.addEventListener('click', function () {
          more.classList.remove('open');
        });
      });
    });
    document.addEventListener('click', function (e) {
      var inAny = false;
      allMore.forEach(function (m) { if (m.contains(e.target)) inAny = true; });
      if (!inAny) { allMore.forEach(function (m) { m.classList.remove('open'); }); }
    });
  })();
  </script>
